rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // `ridv login` handoff slots, keyed by a random 32+ char code only the CLI and the browser know.
    // Create-only, own uid only; anyone holding the code may read/delete it once (no listing). TTL on expireAt.
    match /cliLogins/{code} {
      allow create: if signedIn()
        && code.size() >= 32
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'refreshToken', 'createdAt', 'expireAt']);
      allow get, delete: if true;
    }

    match /users/{userId} {
      allow read, write: if ownsUserDoc(userId);

      match /categories/{categoryId} {
        allow read, write: if ownsUserDoc(userId);
      }

      match /expenses/{expenseId} {
        allow read, write: if ownsUserDoc(userId);
      }
    }
  }
}
